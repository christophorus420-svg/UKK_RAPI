# ==============================================================================
# KONFIGURASI PRODUCTION ENVIRONMENT (RAPI-SEKOLAH / UKKphorus)
# Salin file ini menjadi .env di server produksi Anda
# ==============================================================================

APP_NAME="RAPI-Sekolah"
APP_ENV=production
# Generate APP_KEY baru di server via: php artisan key:generate --show
APP_KEY=base64:OIveKgdxUaV8YaeV6oc8DgsfZ4iF9Msg9aJwN0Bcvog=
APP_DEBUG=false
# Ganti dengan domain/subdomain produksi Anda (contoh: https://rapi-sekolah.sch.id)
APP_URL=https://domain-anda.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ==============================================================================
# KREDENSIAL DATABASE MYSQL PRODUKSI (Disediakan oleh Hosting / VPS / Cloud)
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nama_database_produksi
DB_USERNAME=nama_user_database
DB_PASSWORD=password_user_database

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# ==============================================================================
# PENGATURAN EMAIL (SMTP GMAIL / WEBMAIL SEKOLAH)
# ==============================================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=email-pengirim@gmail.com
MAIL_PASSWORD=app-password-gmail-anda
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="email-pengirim@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

