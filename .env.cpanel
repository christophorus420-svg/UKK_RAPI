APP_NAME="RAPI-Sekolah"
APP_ENV=production
APP_KEY=base64:OIveKgdxUaV8YaeV6oc8DgsfZ4iF9Msg9aJwN0Bcvog=
APP_DEBUG=false
APP_URL=https://ukk-christo.web.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Ganti sesuai dengan database MySQL yang Anda buat di cPanel:
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=heqahean_rapi_sekolah
DB_USERNAME=heqahean_dbuser
DB_PASSWORD=ISI_PASSWORD_DATABASE_DISINI

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=rapi_sekolah_cache_

# Konfigurasi Mail (Opsional - sesuaikan jika menggunakan SMTP hosting)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.ukk-christo.web.id
MAIL_PORT=465
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="no-reply@ukk-christo.web.id"
MAIL_FROM_NAME="${APP_NAME}"

